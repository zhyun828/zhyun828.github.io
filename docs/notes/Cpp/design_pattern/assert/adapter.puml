@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #334155
skinparam classBorderColor #334155
skinparam classBackgroundColor #FFEDD5
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #94A3B8
skinparam nodesep 55
skinparam ranksep 55
hide empty members
title Adapter
interface "Adapter (Target)" as Target {
 +operation()
}
class ConcreteAdapter {
 -adaptee
 +operation()
}
class Adaptee {
 +adaptedOperation()
}
class Client
Target <|.. ConcreteAdapter
ConcreteAdapter --> Adaptee : adaptee
Client --> Target
@enduml
